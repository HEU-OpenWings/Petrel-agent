{
  "name": "petrel-agent",
  "version": "0.5.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nodemon --legacy-watch --watch apps/server --watch packages --ext ts --exec \"tsx --tsconfig tsconfig.base.json apps/server/src/index.ts\"",
    "build": "pnpm --recursive --if-present run build",
    "start": "pnpm --filter @petrel/server start",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^28.0.0",
    "nodemon": "^3.1.14",
    "pinia": "^3.0.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.13"
  }
}
