# development | production | test
NODE_ENV=development
PORT=5050
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# 模型 provider 凭据。由 pi-ai 的 auth 机制解析，不经过 @petrel/config。
# 只需填写你想用的那几家；未填 key 的 provider 不会出现在前端模型选择器里。
# 默认模型是 DeepSeek 官方的 deepseek-v4-flash，只有这一个是必填的。
DEEPSEEK_API_KEY=
# 备选 provider，defaultModel 指回 SiliconFlow 时才需要
SILICONFLOW_API_KEY=

# 其余云厂商（全部可选，按需填写）：
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google Gemini
GEMINI_API_KEY=
# Moonshot AI (Kimi)
MOONSHOT_API_KEY=
# MiniMax
MINIMAX_API_KEY=
# Z.AI
ZAI_API_KEY=
# 阿里云 Qwen Token Plan
QWEN_TOKEN_PLAN_API_KEY=

# 本地推理服务（OpenAI 兼容端点，全部可选）。
# Ollama 的 baseUrl 写死 http://localhost:11434/v1（packages/agent/src/models/providers.ts）；
# vLLM 的 baseUrl 走下面的 VLLM_BASE_URL（留空回落 :8000/v1），由 @petrel/config 读取。
# 两者 API key 本地通常留空，但 pi 需要某个 *_API_KEY 存在才判该 provider「已配置」
# ——想用时填任意非空占位即可（如 "ollama"）。决定是否出现在选择器里的是 API key，不是 baseUrl。
OLLAMA_API_KEY=
# vLLM 没有官方默认端口，按本机启动参数填，如 http://localhost:8001/v1
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=

# Postgres 连接串。compose 内用服务名 db，宿主机直连用 localhost
DATABASE_URL=postgres://petrel:petrel@db:5432/petrel

# JWT 签名密钥。生产环境必填，缺失会让进程启动失败
# 生成方式：openssl rand -base64 32
JWT_SECRET=

# admin 邮箱名单，逗号分隔。名单里的邮箱注册或登录时自动获得 admin 角色
ADMIN_EMAILS=

# ---- 邮件（邮箱验证 / 密码重置依赖它）----
# 开发与测试默认 console：邮件打到后端日志（含验证/重置链接），零外部依赖可跑通。
# 生产环境必须 MAIL_TRANSPORT=smtp 并填齐 SMTP_*，否则进程启动失败。
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 465 端口（SSL）设为 true；587（STARTTLS）通常为 false
SMTP_SECURE=false
MAIL_FROM=Petrel <no-reply@petrel.local>

# 邮件里的链接前缀：生产指到站点对外域名（与前端同源的 API 地址）
PUBLIC_API_URL=http://localhost:5050
# 后端渲染页里「返回登录」的链接（前端 SPA 地址）
PUBLIC_WEB_URL=http://localhost:5173

# 邮箱验证开关。默认 true（安全默认）：注册发验证邮件、未验证不能登录。
# 开发 / 内网演示可显式关掉：注册即登录、不发验证邮件。公开部署必须保持 true。
EMAIL_VERIFICATION_ENABLED=true

# ---- 认证限流（单实例内存计数，多副本共享在风控 issue）----
# 注册按 IP：默认 5 次 / 15 分钟
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MINUTES=15
# 忘记密码 / 重发验证按邮箱：默认 3 次 / 15 分钟
AUTH_MAIL_RATE_LIMIT_MAX=3
AUTH_MAIL_RATE_LIMIT_WINDOW_MINUTES=15

# 上下文自动压缩。阈值 = min(模型 contextWindow × RATIO, CAP)
# 留空表示用默认值；填了非法值（如 RATIO=0 / =1 / ENABLED=yes）则进程启动失败
# ENABLED=false 是彻底关掉：连「撞了模型窗口之后的兜底压缩」也不再发生，
# 那种情况下用户会被告知「自动压缩已关闭，请新建会话」
COMPACTION_ENABLED=true
COMPACTION_THRESHOLD_RATIO=0.8
COMPACTION_ABSOLUTE_CAP=120000

# HEU-40 配额与 token 计量。
# 以下三项留空等号（=）也会被当成「未设置」而回落到默认值——不会因空串变成 0。
# 但若显式填了非法值（如 LIMIT=abc / =-1），进程启动失败。
# TOKEN_LIMIT 是 dev 占位，生产开放注册前必须据真实用量分布重配。
# ENFORCEMENT=false 时只计量（双写 token_usage）不拦截，便于分阶段验证事实一致性后再开拦截。
QUOTA_TOKEN_LIMIT=1000000
QUOTA_WINDOW_HOURS=24
QUOTA_ENFORCEMENT=false
