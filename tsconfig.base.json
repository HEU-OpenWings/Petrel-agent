{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "composite": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@petrel/agent": ["packages/agent/src/index.ts"],
      "@petrel/config": ["packages/config/src/index.ts"],
      "@petrel/database/testing": ["packages/database/src/testing.ts"],
      "@petrel/database": ["packages/database/src/index.ts"],
      "@petrel/logger": ["packages/logger/src/index.ts"]
    }
  }
}
